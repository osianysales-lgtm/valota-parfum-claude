#!/usr/bin/env bash
# Porta de entrada da skill. Uso: bash scripts/efeito <comando> [argumentos]
#   setup                                   instala tudo (uma vez; pode rodar de novo)
#   preparar VIDEO --inicio A --fim B       prepara o vídeo e cria a pasta de trabalho
#   renderizar PASTA --folha | --quadros 1.2,2.8 | --final
#   palavras VIDEO                          tempo de cada palavra falada
# O que é instalado fica em ~/.efeito (ou em $EFEITO_HOME), nunca dentro da pasta da skill.
set -e
SKILL="$(cd "$(dirname "$0")/.." && pwd)"
FX="${EFEITO_HOME:-$HOME/.efeito}"
export PATH="$FX/venv/bin:$FX/bin:$PATH"
cmd="${1:-}"; [ $# -gt 0 ] && shift
PY="$(cat "$FX/python" 2>/dev/null || true)"
precisa() { if [ -z "$PY" ] || [ ! -x "$PY" ]; then echo "Rode primeiro: bash \"$SKILL/scripts/efeito\" setup"; exit 1; fi; }
case "$cmd" in
  setup)      exec bash "$SKILL/scripts/setup.sh" ;;
  preparar)   precisa; exec "$PY" "$SKILL/scripts/preparar.py" "$@" ;;
  palavras)   precisa; exec "$PY" "$SKILL/scripts/palavras.py" "$@" ;;
  renderizar) precisa; NODE_PATH="$FX/node/node_modules" exec node "$SKILL/scripts/renderizar.cjs" "$@" ;;
  *) sed -n '2,7p' "$0"; exit 1 ;;
esac
