<!DOCTYPE html>
<html><head><meta charset="utf-8">
<style>
@font-face{font-family:MB;src:url(fontes/Montserrat-Black.ttf)}
@font-face{font-family:MX;src:url(fontes/Montserrat-ExtraBold.ttf)}
@font-face{font-family:MBo;src:url(fontes/Montserrat-Bold.ttf)}
@font-face{font-family:GB;src:url(fontes/GothamBlack.otf)}
:root{--pet:#0F2E33;--noite:#0A1F23;--luz:#1A4A52;--amb:#D49A4E;--cre:#F2E8D8;--ama:#FFC93C}
*{margin:0;padding:0;box-sizing:border-box}
html,body{width:1080px;height:1920px;overflow:hidden;background:#0d0d10}
#bg{position:absolute;left:0;top:-8px;width:1080px;height:1935px;object-fit:cover}
#luz{position:absolute;inset:0;pointer-events:none;
 background:radial-gradient(ellipse 760px 520px at 540px 1260px,rgba(255,214,160,.16),rgba(255,214,160,0) 70%),
            radial-gradient(ellipse 900px 700px at 540px 640px,rgba(242,232,216,.07),rgba(242,232,216,0) 70%)}
#vin{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 820px 1150px at 540px 960px,rgba(0,0,0,0) 55%,rgba(0,0,0,.45) 100%)}
/* títulos fixos */
.tit{position:absolute;top:400px;width:340px;margin-left:-170px;text-align:center;font-family:MX;font-size:50px;line-height:1.02;letter-spacing:1px;color:var(--cre);
 text-shadow:0 4px 18px rgba(0,0,0,.65)}
.tit.mel{color:var(--ama)}
.seta{position:absolute;top:560px;width:40px;height:92px;margin-left:-20px}
/* frascos */
.fr{position:absolute;transform-origin:50% 100%}
.fr img.f{position:absolute;inset:0;width:100%;height:100%;filter:brightness(.9) contrast(1.03)}
.sh{position:absolute;height:34px;border-radius:50%;background:radial-gradient(ellipse at 50% 50%,rgba(0,0,0,.8),rgba(0,0,0,0) 70%);filter:blur(4px)}
.rf{position:absolute;transform:scaleY(-1);transform-origin:50% 0;opacity:.0;-webkit-mask-image:linear-gradient(0deg,rgba(0,0,0,.0) 72%,rgba(0,0,0,1) 100%)}
.rf img{width:100%;height:100%;filter:brightness(.7) blur(1.5px)}
.nm{position:absolute;width:340px;margin-left:-170px;text-align:center}
.nm span{display:block;font-family:MX;font-size:31px;line-height:1.1;color:var(--cre);text-shadow:0 3px 12px rgba(0,0,0,.8)}
.nm b{display:block;margin-top:8px;font-family:MBo;font-weight:normal;font-size:18px;letter-spacing:5px;color:var(--amb);text-shadow:0 2px 8px rgba(0,0,0,.8)}
#mao{position:absolute;left:0;top:0;width:850px;height:1448px;transform-origin:0 0;opacity:0;filter:drop-shadow(0 26px 30px rgba(0,0,0,.5)) brightness(.92)}
/* final */
#cta{position:absolute;inset:0;opacity:0;overflow:hidden}
#cta .fundo{position:absolute;left:-40px;top:-48px;width:1160px;height:2015px;object-fit:cover;filter:blur(22px) brightness(.42)}
#cta .tint{position:absolute;inset:0;background:radial-gradient(ellipse 900px 1300px at 50% 50%,rgba(15,46,51,.55),rgba(10,31,35,.92))}
#cta .c{position:absolute;left:60px;right:60px;text-align:center}
.q1{top:330px;font-family:MX;font-size:56px;line-height:1.14;color:var(--cre)}
.q2{top:478px;font-family:GB;font-size:82px;line-height:1.06;color:var(--ama);letter-spacing:1px}
#card{position:absolute;left:190px;top:760px;width:700px;height:640px;border-radius:44px;background:rgba(10,31,35,.78);border:2px solid rgba(212,154,78,.55);box-shadow:0 40px 90px rgba(0,0,0,.55);text-align:center}
#card .av{position:absolute;left:225px;top:56px;width:250px;height:250px;border-radius:50%;padding:7px;background:linear-gradient(135deg,var(--ama),var(--amb))}
#card .av img{width:100%;height:100%;border-radius:50%;border:6px solid var(--noite);object-fit:cover;display:block}
#card .u{position:absolute;left:0;right:0;top:340px;font-family:MX;font-size:50px;color:var(--cre)}
#card .n{position:absolute;left:0;right:0;top:410px;font-family:MBo;font-size:30px;color:var(--amb);letter-spacing:1px}
#card .bt{position:absolute;left:170px;top:488px;width:360px;height:96px;border-radius:24px;background:var(--ama);color:var(--pet);font-family:MX;font-size:42px;line-height:96px}
.siga{top:1480px;font-family:MX;font-size:54px;line-height:1.16;color:var(--cre)}
.siga em{font-style:normal;color:var(--ama)}
</style></head><body>
<img id="bg" src="mao/cenario_petroleo.jpg">
<div id="luz"></div>
<div id="cena"></div>
<div id="vin"></div>
<div id="tits"></div>
<img id="mao" src="mao/mao_pov_final.png">
<div id="cta">
 <img class="fundo" src="mao/cenario_petroleo.jpg"><div class="tint"></div>
 <div class="c q1">QUER ENCONTRAR AS<br>MELHORES OFERTAS DE</div>
 <div class="c q2">PERFUMES<br>ORIGINAIS?</div>
 <div id="card"><div class="av"><img src="mao/avatar.png"></div><div class="u">@valotaparfum</div><div class="n">Valota Parfum</div><div class="bt">Seguir</div></div>
 <div class="c siga">ME SEGUE E CLICA<br>NO <em>LINK DA BIO</em></div>
</div>
<script>
/*DADOS*/
const D=window.D,$=s=>document.querySelector(s);
const cl=(x,a=0,b=1)=>Math.max(a,Math.min(b,x)),eo=p=>1-Math.pow(1-p,3),ei=p=>p*p*p,eio=p=>p<.5?4*p*p*p:1-Math.pow(-2*p+2,3)/2,
 eb=p=>{const c1=1.70158,c3=c1+1;return 1+c3*Math.pow(p-1,3)+c1*Math.pow(p-1,2)},lerp=(a,b,u)=>a+(b-a)*u;
const CX=[190,540,890],BASE=1392,COL=[2,1,0];
// títulos + setas
$('#tits').innerHTML=[['O MELHOR<br>DOS 3','mel'],['SURREAL',''],['BOM','']].map((w,i)=>
 `<div class="tit ${w[1]}" style="left:${CX[i]}px;${i?'top:426px':''}">${w[0]}</div>`+
 `<svg class="seta" style="left:${CX[i]}px" viewBox="0 0 40 92"><path d="M20 4v78M6 66l14 16 14-16" fill="none" stroke="${i?'#D49A4E':'#FFC93C'}" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>`).join('');
const cena=$('#cena');
const TR=D.TRIOS.map((tr,k)=>{const g=document.createElement('div');cena.appendChild(g);
 const B=tr.map((b,j)=>{const x=CX[COL[j]],L=x-b.w/2,T=BASE-b.h;
  const sh=document.createElement('div');sh.className='sh';Object.assign(sh.style,{left:(x-b.w*0.62)+'px',width:(b.w*1.24)+'px',top:(BASE-18)+'px'});
  const rf=document.createElement('div');rf.className='rf';Object.assign(rf.style,{left:L+'px',top:(BASE+2)+'px',width:b.w+'px',height:b.h+'px'});rf.innerHTML=`<img src="${b.img}">`;
  const f=document.createElement('div');f.className='fr';Object.assign(f.style,{left:L+'px',top:T+'px',width:b.w+'px',height:b.h+'px'});f.innerHTML=`<img class="f" src="${b.img}">`;
  const nm=document.createElement('div');nm.className='nm';Object.assign(nm.style,{left:x+'px',top:(BASE+34)+'px'});nm.innerHTML=`<span>${b.nome}</span><b>${b.marca}</b>`;
  [sh,rf,f,nm].forEach(e=>g.appendChild(e));
  const s=cl(b.w/497,0.45,0.64);
  return {b,x,L,T,s,sh,rf,f,nm};
 });return {g,B,ini:D.INI[k],fim:D.FIM[k]}});
const mao=$('#mao');
// movimento: o frasco vem de baixo (perto da câmera, um pouco maior), sobe até a mesa e pousa
function carry(b,t,o){const u=t-b.tin;
 const p=eo(cl(u/0.66)),pd=eio(cl((u-0.66)/0.2));
 const dx=(540-o.x)*0.4*(1-p);
 let dy=lerp(760,-18,p);dy=lerp(dy,0,pd);
 const sc=lerp(1.16,1,p),rot=(o.x<540?2.2:-2.2)*(1-p);
 return {dx,dy,sc,rot,u}}
window.render=function(t){
 let maoOn=false;
 TR.forEach(({g,B,ini,fim})=>{
  const vis=t>=ini-1&&t<fim;g.style.display=vis?'block':'none';if(!vis)return;
  B.forEach(o=>{const b=o.b;
   if(t<b.tin){[o.f,o.sh,o.rf,o.nm].forEach(e=>e.style.opacity=0);return}
   const c=carry(b,t,o),u=c.u;
   const assent=cl(1-Math.abs(c.dy)/45);
   const sq=u>0.84&&u<1.1?1-0.012*Math.sin(Math.PI*cl((u-0.84)/0.25)):1;
   o.f.style.opacity=1;
   o.f.style.transform=`translate(${c.dx.toFixed(1)}px,${c.dy.toFixed(1)}px) rotate(${c.rot.toFixed(2)}deg) scale(${c.sc.toFixed(4)}) scaleY(${sq.toFixed(4)})`;
   o.sh.style.opacity=(0.85*Math.pow(assent,2)).toFixed(3);
   o.sh.style.transform=`scaleX(${(0.7+0.3*assent).toFixed(3)})`;
   o.rf.style.opacity=(0.2*cl((u-0.8)/0.25)).toFixed(3);
   const pn=cl((u-0.9)/0.35);o.nm.style.opacity=eo(pn).toFixed(3);o.nm.style.transform=`translateY(${(14*(1-eo(pn))).toFixed(1)}px)`;
   // mão: segura por baixo/por trás enquanto carrega, solta e desce pra fora da tela
   if(u<1.7){maoOn=true;
    const r=ei(cl((u-1.0)/0.6)),afr=eo(cl((u-0.92)/0.12));
    const gx=o.x+c.dx-b.w/2*c.sc+(o.x<540?-1:1)*50*r,gy=BASE+c.dy+6*afr+950*r;
    mao.style.opacity=(1-cl((u-1.55)/0.15)).toFixed(3);
    mao.style.transform=`translate(${gx.toFixed(1)}px,${gy.toFixed(1)}px) rotate(${(c.rot*1.2).toFixed(2)}deg) scale(${(o.s*c.sc*(1+0.1*r)).toFixed(4)}) translate(-175px,-720px)`;
   }
  });
 });
 if(!maoOn)mao.style.opacity=0;
 // ── final
 const C=D.CTA,ct=$('#cta');const a=cl((t-C.ini)/0.35);ct.style.opacity=a.toFixed(3);ct.style.display=a>0?'block':'none';
 if(a>0){
  const q=eo(cl((t-C.ini-0.1)/0.5));ct.querySelector('.q1').style.cssText+=`;opacity:${q};transform:translateY(${(30*(1-q)).toFixed(1)}px)`;
  const q2=eo(cl((t-C.ini-0.35)/0.5));ct.querySelector('.q2').style.cssText+=`;opacity:${q2};transform:translateY(${(30*(1-q2)).toFixed(1)}px) scale(${(0.9+0.1*eb(cl((t-C.ini-0.35)/0.5))).toFixed(3)})`;
  const cd=cl((t-C.card)/0.5);const card=$('#card');card.style.opacity=eo(cd).toFixed(3);card.style.transform=`translateY(${(60*(1-eo(cd))).toFixed(1)}px) scale(${(0.86+0.14*eb(cd)).toFixed(3)})`;
  const sg=eo(cl((t-C.siga)/0.45));const si=ct.querySelector('.siga');si.style.opacity=sg.toFixed(3);si.style.transform=`translateY(${(26*(1-sg)).toFixed(1)}px)`;
  const bt=card.querySelector('.bt'),tp=Math.sin(Math.PI*cl((t-C.toque)/0.3));
  bt.style.transform=`scale(${(1-0.08*tp).toFixed(3)})`;
  if(t>=C.toque+0.15){bt.textContent='Seguindo';bt.style.background='transparent';bt.style.color='#F2E8D8';bt.style.border='3px solid #D49A4E';bt.style.lineHeight='90px'}
  else{bt.textContent='Seguir';bt.style.background='#FFC93C';bt.style.color='#0F2E33';bt.style.border='none';bt.style.lineHeight='96px'}
  bt.style.boxShadow=`0 0 ${(40*Math.max(tp,0.3)).toFixed(0)}px rgba(255,201,60,${(0.45*Math.max(tp,t<C.toque?0.6:0)).toFixed(2)})`;
 }
};
</script></body></html>
