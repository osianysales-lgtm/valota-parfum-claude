def render(htmltxt, png):
    with tempfile.NamedTemporaryFile("w", suffix=".html", delete=False, encoding="utf-8") as t:
        t.write(htmltxt)
    subprocess.run([CHROME, "--headless=new", "--disable-gpu", "--hide-scrollbars",
                    "--allow-file-access-from-files", "--force-device-scale-factor=1",
                    f"--window-size={L},{A}", "--virtual-time-budget=4000",
                    f"--screenshot={png}", Path(t.name).as_uri()], check=True, capture_output=True)


def main():
    arq = Path(sys.argv[1]).resolve()
    base = arq.parent
    d = json.loads(arq.read_text(encoding="utf-8"))
    saida = base / "saida"
    saida.mkdir(exist_ok=True)
    import capa_variantes  # capa A aprovada em 12/11/2026 (3 tarjas sobre o frasco em estúdio)
    capa = [capa_variantes.capa_a(d["capa"], uri(d["capa"]["frasco"], base))] if d.get("capa") else []
    paginas = capa + [slide_bloco(d, b, base) for b in d["blocos"]] + [slide_final(d, d["final"], base)]
    nomes = []
    for k, p in enumerate(paginas, 1):
        png = saida / f"{k:02d}.png"
        render(p, png)
        nomes.append(png.name)
        print("ok", png)
    (saida / "previa.html").write_text(
        '<body style="background:#222;display:flex;flex-wrap:wrap;gap:12px;padding:12px">' +
        "".join(f'<img src="{n}" style="width:360px">' for n in nomes) + "</body>", encoding="utf-8")


if __name__ == "__main__":
    main()
