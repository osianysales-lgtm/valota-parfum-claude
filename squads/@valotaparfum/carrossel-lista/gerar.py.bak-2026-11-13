def slide_bloco(d, b, base):
    fundo = b["fundo"]
    escuro = fundo in ("petroleo", "foto")
    txt = CREME if escuro else NOITE
    num = AMBAR if escuro else LUZ
    apoio = "rgba(242,232,216,.6)" if escuro else "rgba(10,31,35,.55)"
    halo = ("background:radial-gradient(circle,rgba(242,232,216,.20) 0%,rgba(242,232,216,0) 70%);" if escuro
            else "background:radial-gradient(circle,rgba(255,255,255,.75) 0%,rgba(255,255,255,0) 70%);")
    chips = chip(b["chip"], escuro) + (chip(b["chip2"], escuro) if b.get("chip2") else "")
    itens = "".join(f"""
  <div class="item">
    <div class="frasco" style="{halo}"><img src="{uri(i['frasco'], base)}"></div>
    <div>
      <div class="nome"><span class="n" style="color:{num}">{i['n']}.</span>{html.escape(i['nome'])}</div>
      {f'<div class="lembra">lembra <strong>{html.escape(i["lembra"])}</strong></div>' if i.get("lembra") else ""}
      <div class="notas">{html.escape(i['notas'])}</div>
    </div>
  </div>""" for i in b["itens"])
    fundo_html = ""
    classe = {"creme": "grade-creme", "petroleo": "grade-petroleo"}.get(fundo, "")
    if fundo == "foto":
        fundo_html = (f'<div style="position:absolute;inset:0;background:url(\'{uri(b["foto"], base)}\') {b.get("foto_pos", "30% 100%")}/cover no-repeat,{NOITE}"></div>'
                      f'<div style="position:absolute;inset:0;background:linear-gradient(180deg,{NOITE} 0%,rgba(10,31,35,.95) 50%,rgba(10,31,35,.88) 74%,rgba(10,31,35,.45) 88%,rgba(10,31,35,.30) 100%)"></div>')
    corpo = f"""{fundo_html}
<div class="topo" style="color:{apoio}">{html.escape(d['topo'])}</div>
<div class="conteudo" style="color:{txt}">
  <div class="chips">{chips}</div>
  <h2>{html.escape(b['titulo'])}</h2>{itens}
</div>
<div class="rodape" style="color:{txt}">{html.escape(d['rodape'])}</div>"""
    if len(b["itens"]) >= 3:  # 3 frascos por slide: versão compacta
        corpo = COMPACTO + corpo
    return pagina(corpo, classe)


