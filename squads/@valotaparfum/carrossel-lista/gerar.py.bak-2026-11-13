def uri(c, base):
    p = (base / c).resolve()
    if not p.exists():
        print("  aviso: não achei", p)
    return p.as_uri()


def rico(t):
    t = html.escape(t or "")
    t = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", t)
    return t.replace("\n", "<br>")


def chip(c, sobre_petroleo):
    cor, txt = FAMILIAS[c["familia"]]
    borda = f"border:2px solid {CREME};" if (sobre_petroleo and c["familia"] in ("cedro", "pimenta")) else "border:2px solid transparent;"
    return (f'<span class="chip" style="background:{cor};color:{txt};{borda}">'
            f'<svg viewBox="0 0 24 24">{ICONES[c["icone"]]}</svg>{html.escape(c["rotulo"])}</span>')


